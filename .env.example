# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* at bundle time, so these
# values ship inside the app — only ever put publishable keys here.
# After editing, restart Metro with: npx expo start --clear

# Backend API. Note: on a physical device or Android emulator "localhost" points
# at the device itself, not your machine — use your LAN IP (e.g. 192.168.1.20)
# or an Android-emulator loopback of 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps JavaScript API key — same key the web app uses for
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY. Loads the Sales Map (rendered in a WebView)
# and is called directly from the app for Add Account's venue-name
# autocomplete (Places API). Ships inside the app bundle — same exposure the
# web app already has with its own key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
